{
  "name": "smriti-platform-monorepo",
  "version": "1.0.0",
  "description": "SMRITI: AI-Based Cognitive Gaming and Memory Assistance Platform (Team Axiom • SIH 2026 PS 26003)",
  "private": true,
  "workspaces": [
    "FE",
    "BE"
  ],
  "scripts": {
    "dev": "npm --prefix BE run dev",
    "dev:backend": "npm --prefix BE run dev",
    "dev:frontend": "npm --prefix FE run dev",
    "dev:ai": "python -m uvicorn AI.src.api:app --reload --port 8000",
    "build": "npm --prefix FE install && npm --prefix FE run build && npm --prefix BE install && npm --prefix BE run build",
    "build:frontend": "npm --prefix FE install && npm --prefix FE run build",
    "build:backend": "npm --prefix BE install && npm --prefix BE run build",
    "start": "npm --prefix BE start",
    "test:frontend": "npm --prefix FE test",
    "test:backend": "npm --prefix BE test",
    "test:ai": "python AI/tests/test_adaptive_engine.py",
    "test:browser": "node scripts/full_browser_acceptance_suite.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@supabase/supabase-js": "^2.114.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
