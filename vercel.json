{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "FE/dist",
  "functions": {
    "api/ai.py": {
      "includeFiles": "AI/**",
      "excludeFiles": "{node_modules/**,FE/**,dist/**,BE/**,.git/**}"
    },
    "api/index.ts": {
      "includeFiles": "{BE/**,AI/data/**}",
      "excludeFiles": "{FE/**,dist/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/ai/:path*", "destination": "/api/ai.py" },
    { "source": "/api/ai/:path*", "destination": "/api/ai.py" },
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
